<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" prefHeight="300.0" prefWidth="400.0" spacing="15.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.programowanie5.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label text="RPG">
        <font>
            <Font name="System Bold" size="16.0" />
        </font>
    </Label>
    <VBox prefHeight="35.0" prefWidth="0.0">
        <Label fx:id="InvLb" text="Rzeczy w ekwipunku: " />
        <Label fx:id="ManaLb" text="Aktualna Mana: 50" />
    </VBox>

    <VBox spacing="5.0">
        <Label prefHeight="18.0" prefWidth="162.0" text="Rzuć zaklęcie (kosztuje mane)" />
        <TextField fx:id="manaInput" promptText="Wpisz ile many chcesz zużyć " />
    </VBox>

    <VBox spacing="5.0">
        <Label text="Przedmiot do podniesienia (kosztuje miejsce w ekwipunku)" />
        <TextField fx:id="itemInput" promptText="Nazwa przedmiotu który chcesz podnieść, np. Miecz" />
    </VBox>

    <Button maxWidth="Infinity" onAction="#onExecuteActionClick" text="Wykonaj Akcję" />
</VBox>
