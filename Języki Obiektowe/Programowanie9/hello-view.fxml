<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" prefHeight="294.0" prefWidth="327.0" spacing="20.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.programowanie9.HelloController">
  <padding>
    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
  </padding>
   <children>
      <Label fx:id="topLabel" />
       <ImageView fx:id="imageView" pickOnBounds="true" preserveRatio="true" />
       <Button fx:id="changeImgButton" mnemonicParsing="false" text="Nasępny Obrazek" onAction="#changeImg"/>
   </children>
</VBox>
